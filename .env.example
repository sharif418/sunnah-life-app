# ═════════════════════════════════════════════════════════════════════════════
# Sunnah Life — environment template
#
#   cp .env.example .env    → then FILL IN every "change-me" secret.
#
# Used by: infra/docker-compose.yml (docker compose --env-file .env …) and the
# individual apps when running outside compose. Variable-by-variable guidance
# lives in docs/DEPLOY_COOLIFY.md §Environment variables — keep both in sync.
#
# NEVER commit .env. Generate secrets with:  openssl rand -base64 48
# ═════════════════════════════════════════════════════════════════════════════

# ── PostgreSQL 16 ────────────────────────────────────────────────────────────
# Owner/migration role (used via DIRECT_URL; bypasses RLS — keep private).
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-pg-superuser
# NOTE: keep this `sunnahlife` — the API's RLS migration grants on this exact
# database name (apps/api/prisma/migrations/*_rls).
POSTGRES_DB=sunnahlife
# Restricted runtime role created by infra/postgres/init-rls.sql (NOBYPASSRLS).
# The compose file interpolates it into DATABASE_URL — change once here.
SUNNAH_APP_PASSWORD=change-me-app-role
# Small VPS tuning (optional).
PG_SHARED_BUFFERS=256MB
PG_MAX_CONNECTIONS=100

# ── Object storage (MinIO → S3 API) ──────────────────────────────────────────
# MinIO root credentials = the S3 keys the api uses (keep the pairs equal).
MINIO_ROOT_USER=sunnahlife
MINIO_ROOT_PASSWORD=change-me-minio-root
S3_BUCKET=sunnahlife
# S3_ENDPOINT / S3_ACCESS_KEY / S3_SECRET_KEY are derived by compose
# (http://minio:9000, MINIO_ROOT_USER/PASSWORD) — set them here only when
# running the api outside compose against another S3:
#S3_ENDPOINT=http://localhost:9000
#S3_ACCESS_KEY=sunnahlife
#S3_SECRET_KEY=change-me-minio-root

# ── Search (Meilisearch) ─────────────────────────────────────────────────────
# Container env var is MEILI_MASTER_KEY; the api reads the same value as MEILI_KEY
# (compose maps one .env value into both).
MEILI_MASTER_KEY=change-me-meili-32-bytes-minimum

# ── Redis (BullMQ) ────────────────────────────────────────────────────────────
# Inside compose: redis://redis:6379 (hard-wired in the service env).
# Outside compose (e.g. local api dev):
#REDIS_URL=redis://127.0.0.1:6380
#DATABASE_URL=postgresql://sunnah_app:change-me-app-role@127.0.0.1:5432/sunnahlife
#DIRECT_URL=postgresql://postgres:change-me-pg-superuser@127.0.0.1:5432/sunnahlife
#MEILI_HOST=http://127.0.0.1:7700

# ── API (NestJS — apps/api) ───────────────────────────────────────────────────
# Names below are exactly what apps/api/src/config/env.validation.ts reads.
# (C/W2h) The api publishes NO host port in compose — caddy (the only ingress)
# talks to api:4000 over the sunnah network; --scale api=N adds REST capacity.
# Bearer/query token that unlocks GET /metrics (unset ⇒ /metrics is open in
# non-production and 403s in production).
#METRICS_TOKEN=
# "false" disables the Swagger UI (/docs) + /openapi.json; unset ⇒ enabled
# outside production only.
#DOCS_ENABLED=
# One secret is enough: access tokens are signed with JWT_SECRET, refresh
# tokens with JWT_REFRESH_SECRET when set, else JWT_SECRET (rotation + family
# revocation happen via the RefreshToken table either way).
JWT_SECRET=change-me-jwt-secret-min-8-chars
# HMAC secret for live-quiz room tokens (GET /api/quiz/live-token).
QUIZ_SECRET=change-me-quiz-secret-32-bytes
#JWT_REFRESH_SECRET=
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=7
# Public domain (referral links, canonical URLs).
APP_DOMAIN=sunnahlife.app
# Browser origins allowed to call the api with credentials.
CORS_ORIGINS=http://localhost:3000,http://localhost:3002
# SMS gateway: mock (default — OTP code returned as devCode) | sslwireless | infobip
SMS_PROVIDER=mock
#SMS_SSLWIRELESS_URL=
#SMS_SSLWIRELESS_USER=
#SMS_SSLWIRELESS_PASS=
#SMS_INFOBIP_URL=
#SMS_INFOBIP_KEY=
# Public CDN base for S3 objects (leave empty to serve via the api).
#S3_PUBLIC_BASE=
# ── Push notifications (FCM HTTP v1 — Task B2) ──────────────────────────────
# Firebase service-account JSON for the FCM HTTP v1 API: the FULL object as a
# one-line JSON string, OR a path to the .json file reachable by the api and
# worker processes. Empty/absent ⇒ the no-op dev transport (push logged only).
# Create: Firebase console → Project settings → Service accounts → Generate
# new private key (docs/RELEASE.md §Firebase).
#FCM_SERVICE_ACCOUNT_JSON=

# ── Social login (Google + Apple — Task B5) ────────────────────────────────
# id_token audiences the api verifies against the provider JWKS
# (docs/RELEASE.md §social-login). Any of these left empty ⇒ that provider is
# DISABLED: /api/auth/social answers 400 (Bengali) and /api/auth/providers
# reports it off so the mobile buttons stay hidden.
# Google: the OAuth *web* client id of the Google Cloud project — the audience
# of Android id_tokens (the app passes it as serverClientId).
#GOOGLE_CLIENT_ID=
# Optional second Google audience: the iOS OAuth client id (only needed when
# iOS tokens carry it instead — see docs/RELEASE.md §social-login).
#GOOGLE_IOS_CLIENT_ID=
# Apple: the Services ID (Sign in with Apple web-style flow).
#APPLE_SERVICES_ID=
# Optional Apple audience: the app's iOS bundle id — native ASAuthorization
# tokens use it as aud. Set when Apple sign-in is used on iOS.
#APPLE_IOS_BUNDLE_ID=bd.asunnah.sunnahLife
# Reserved for a future Android/web Apple flow (hosted redirect).
#APPLE_TEAM_ID=

# ── Web + Admin (Next.js clients) ─────────────────────────────────────────────
WEB_PORT=3000
ADMIN_PORT=3002
# ONE variable for both web and admin: the public API origin, baked into the
# client bundles at BUILD time (Docker build arg, or env for `bun run dev`).
# Empty → same-origin requests (a reverse proxy fronts the clients and /api).
# Local dev example: http://localhost:4000
NEXT_PUBLIC_API_BASE=

# ── Reverse proxy profile (optional — compose --profile proxy) ───────────────
WEB_DOMAIN=web.sunnahlife.app
ADMIN_DOMAIN=admin.sunnahlife.app
API_DOMAIN=api.sunnahlife.app
ACME_EMAIL=admin@sunnahlife.app

# ── Housekeeping ─────────────────────────────────────────────────────────────
# Tag applied to the built images (sunnahlife/api:$STACK_TAG …). Use e.g. a git
# short SHA when you need rollback-able versions (docs/DEPLOY_COOLIFY.md §Rollback).
STACK_TAG=latest
