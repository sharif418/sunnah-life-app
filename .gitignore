*.tsbuildinfo
next-env.d.ts
local-*
.claude
.z-ai-config
*.log
dev.log
dev.out.log
# sandbox scratch file (ROOT-ONLY — the bare `test` rule used to hide
# apps/mobile/test/ and apps/api/test/ from git!)
/test
prompt

server.log
# Skills directory
/skills/
# ── monorepo (Sunnah Life) ──────────────────────────────────────────────
.turbo
**/node_modules
apps/*/dist
apps/*/.next
apps/api/generated
packages/*/dist
# … EXCEPT the generated typed client surface: apps/web type-checks against
# packages/shared-types/dist/schema.d.ts (`import type`), so a fresh clone
# (and any tsc gate) must have it. Same philosophy as the committed generated
# l10n Dart (apps/mobile/lib/l10n/generated). Regenerate after API route
# changes: `cd packages/shared-types && bun run generate` (boots the Nest app,
# needs apps/api built + env), then commit the diff.
!packages/shared-types/dist
packages/shared-types/dist/*
!packages/shared-types/dist/schema.d.ts
# local databases & runtime (ROOT-ONLY — the bare `db/` rule used to hide
# apps/mobile/lib/db/, the Drift database, from git!)
*.db
*.db-journal
/db/
# flutter / android
apps/mobile/.dart_tool/
apps/mobile/.flutter-plugins*
apps/mobile/build/
apps/mobile/android/.gradle/
apps/mobile/ios/Pods/
apps/mobile/ios/.symlinks/
apps/mobile/linux/
apps/mobile/macos/
apps/mobile/windows/
apps/mobile/web/
# ── Firebase (Task B2): the REAL credential files never get committed.
# The committed google-services.example.json documents the shape; CI builds
# apply the google-services Gradle plugin ONLY when the real file exists
# (apps/mobile/android/app/build.gradle.kts — file-existence guard).
apps/mobile/android/app/google-services.json
apps/mobile/ios/Runner/GoogleService-Info.plist
# sandbox toolchain artifacts
opt/

# sandbox tool-output dumps (never ship)
tool-results/
apps/mobile/artifacts/

# agent scratch records (worklog.md is the shared log)
agent-ctx/
