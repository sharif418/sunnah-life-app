# ── Sunnah Life API — runtime environment ──────────────────────────────────
# Copy to .env and adjust. Secrets via env only — never committed.

# PostgreSQL. Runtime connects as the RLS-constrained app role; migrations and
# the seed use DIRECT_URL (superuser / owner — bypasses RLS by design).
DATABASE_URL="postgresql://sunnah_app:sunnah_app_dev@127.0.0.1:5433/sunnahlife"
DIRECT_URL="postgresql://postgres@127.0.0.1:5433/sunnahlife"

PORT=3001
CORS_ORIGINS=""             # comma-separated list; empty = allow all (dev)

# Redis (BullMQ queues)
REDIS_URL="redis://127.0.0.1:6380"

# Meilisearch (optional — content search indexes are synced fire-and-forget)
MEILI_HOST="http://127.0.0.1:7700"
MEILI_KEY=""

# JWT — set long random secrets in production
JWT_SECRET="dev-only-secret-change-me-in-production"
JWT_REFRESH_SECRET="dev-only-refresh-secret-change-me-in-production"
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=7

# SMS gateway: mock (returns devCode in response) | sslwireless | infobip
SMS_PROVIDER=mock
SMS_SSLWIRELESS_URL=""
SMS_SSLWIRELESS_USER=""
SMS_SSLWIRELESS_PASS=""
SMS_INFOBIP_URL=""
SMS_INFOBIP_KEY=""

# Content packs (quran, amal catalog, level rules, …). Default: repo packages/content
CONTENT_DIR=""

# Storage for generated reports (monthly PDFs)
STORAGE_DIR="./storage"
# S3/MinIO — when all are set, report uploads are enabled (MinIO client)
S3_ENDPOINT=""
S3_BUCKET=""
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
S3_PUBLIC_BASE=""

# App domain for referral links
APP_DOMAIN="sunnahlife.app"

# ── Social sign-in (Task B5) — Google + Apple id_token audiences ────────────
# Empty/absent ⇒ provider DISABLED: POST /api/auth/social → 400 (Bengali),
# GET /api/auth/providers → {google:false, apple:false} (buttons hidden).
# GOOGLE_CLIENT_ID: the OAuth *web* client id — the id_token audience for the
# Android app (passed there as serverClientId). Optional GOOGLE_IOS_CLIENT_ID
# adds the iOS client id as a second accepted audience.
#GOOGLE_CLIENT_ID=""
#GOOGLE_IOS_CLIENT_ID=""
# APPLE_SERVICES_ID: Apple Services ID (web-flow audience). APPLE_IOS_BUNDLE_ID
# accepts the native iOS flow audience (the app bundle id). APPLE_TEAM_ID is
# reserved for a future Android/web Apple flow (hosted redirect).
#APPLE_SERVICES_ID=""
#APPLE_IOS_BUNDLE_ID=""
#APPLE_TEAM_ID=""
