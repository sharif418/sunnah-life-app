  "info": {
    "title": "Sunnah Life API",
    "description": "দাওয়াতুস সুন্নাহ তারবিয়াত প্ল্যাটফর্ম — auth (OTP + JWT), muhasaba diary, usrah & dawah engine, weekly reviews, assessments, admin console. Every data route is enforced by PostgreSQL Row-Level Security (gender / usrah / downline scoping); auth via `Authorization: Bearer <accessToken>` or the HttpOnly sl_access cookie.",
    "version": "1.0.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      },
      "cookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "sl_access"
      }
    },
    "schemas": {
      "OtpRequestDto": {
        "type": "object",
        "properties": {
          "phone": {
            "type": "string",
            "example": "01000000004"
          }
        },
        "required": [
          "phone"
        ]
      },
      "GuestEntryDto": {
        "type": "object",
        "properties": {
          "amalKey": {
            "type": "string"
          },
          "date": {
            "type": "string",
            "example": "2025-06-15"
          },
          "value": {
            "type": "object",
            "example": "jamaat"
          },
          "clientUpdatedAt": {
            "type": "string",
            "example": "2025-06-15T10:00:00.000Z"
          },
          "source": {
            "type": "string",
            "example": "manual"
          }
        },
        "required": [
          "amalKey",
          "date",
          "value",
          "clientUpdatedAt"
        ]
      },
      "OtpVerifyDto": {
        "type": "object",
        "properties": {
          "phone": {
            "type": "string",
            "example": "01000000004"
          },
          "code": {
            "type": "string",
            "example": "123456"
          },
          "name": {
            "type": "string",
            "example": "রাফিউল ইসলাম"
          },
          "gender": {
            "type": "string",
            "enum": [
              "M",
              "F"
            ]
          },
          "referredByCode": {
            "type": "string",
            "example": "DS-000004"
          },
          "guestEntries": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/GuestEntryDto"
            }
          }
        },
        "required": [
          "phone",
          "code"
        ]
      },
      "RefreshDto": {
