// Sunnah Life — Dawatus Sunnah Tarbiyah Engine
// Prisma schema (PostgreSQL 16 + Row-Level Security).
// Mirrors the repo-root SQLite schema 1:1 (same model/field names) with the
// JSON-string columns typed as Prisma `Json` and an extra RefreshToken table
// for the JWT rotating-refresh auth of the NestJS API.

generator client {
  provider = "prisma-client-js"
  // Bun-workspaces layout: @prisma/client resolves through the .bun store,
  // so the default node_modules/.prisma output is unreachable. Generate into
  // the package itself (re-exported by src/common/prisma-client.ts).
  output   = "../src/generated/prisma"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─────────────────────────── Identity & program ───────────────────────────

model User {
  id            String    @id @default(cuid())
  phone         String?   @unique
  email         String?
  // Set only when an identity provider vouched for `email` (Google/Apple
  // sign-in). An address typed into the profile or imported by an admin
  // stays unverified and is NEVER used to link a social sign-in to the
  // account (security review 2026-10-05: account takeover / cross-gender).
  emailVerifiedAt DateTime?
  // Social sign-in (Task B5): which IdP last linked the account + the
  // provider-stable subject id. Uniqueness (per provider) is enforced by the
  // partial unique indexes in migrations/*_social_auth — see the migration
  // header for why they live in raw SQL (Prisma has no expression/partial DSL).
  socialProvider String?   // google | apple
  socialSub      String?   // IdP-stable subject claim (survives email changes;
                          // Apple only includes `email` on FIRST authorization)
  name          String
  photoUrl      String?
  gender        String // "M" | "F" | "unspecified" (pre-onboarding, social-created) — set once at onboarding, changed only by full_admin
  role          String    @default("user") // user | daee | usrah_head | invigilator | full_admin
  category      String    @default("general") // general | hafez | alim
  memberCode    String?   @unique // DS-000001, assigned when promoted to daee
  referredById  String?
  referredBy    User?     @relation("Referrals", fields: [referredById], references: [id])
  referrals     User[]    @relation("Referrals")
  usrahId       String?
  usrah         Usrah?    @relation("UsrahMembers", fields: [usrahId], references: [id])
  level         String    @default("none") // none | muhibbus_sunnah | farze_ain_1 | farze_ain_2
  levelStartedAt DateTime?
  district      String?
  workplace     String?
  department    String?
  language      String    @default("bn")
  madhhab       String    @default("hanafi")
  // IANA zone for every wall-clock computation this user triggers (prayer
  // pushes, week starts, diary day-lock). Phase C/W1a: was hard-coded UTC+6.
  tz            String    @default("Asia/Dhaka")
  calcMethod    String    @default("karachi")
  lat           Float?
  lng           Float?
  city          String?
  createdAt     DateTime  @default(now())
  lastActiveAt  DateTime  @default(now())
  // set when the member deleted their own account (DELETE /api/me): the row
  // stays only as an anonymous anchor for what they did for others
  deletedAt     DateTime?
  // Content workflow (2026-10-09): who may draft / review the content packs
  // in the admin CMS — orthogonal to the tarbiyah role. null | "editor" |
  // "reviewer" (a reviewer may also draft). Set only by full_admin (column
  // guard trigger).
  contentRole   String?

  sessions              Session[]
  deviceTokens          DeviceToken[]
  refreshTokens         RefreshToken[]
  amalEntries           AmalEntry[]
  personalGoals         PersonalGoal[]
  monthlyReports        MonthlyReport[]
  dayUnlocks            DayUnlock[]   @relation("UnlockedFor")
  unlockActions         DayUnlock[]   @relation("UnlockedBy")
  weeklyReviewsGiven    WeeklyReview[] @relation("Reviewer")
  weeklyReviewsReceived WeeklyReview[] @relation("Reviewee")
  assessmentsGiven      Assessment[]   @relation("Assessor")
  assessmentsReceived    Assessment[]   @relation("Assessee")
  announcements          Announcement[]
  reminders             Reminder[]
  enrollments           Enrollment[]
  quizAttempts          QuizAttempt[]
  masalaQuestions       MasalaQuestion[]
  feedbacks             Feedback[]
  usrahQuestions        UsrahQuestion[]  @relation("UsrahQuestionAuthor")
  usrahAnswers          UsrahQuestion[]  @relation("UsrahQuestionAnswerer")
  supportThreads        SupportThread[]
  supportMessages       SupportMessage[] @relation("SupportMessageAuthor")
  usrahJoinRequests     UsrahJoinRequest[]

  // Lookup index for the social sign-in find-by-email path — created in raw
  // SQL by *_social_auth; declared here (Phase C/W4c) so `prisma migrate dev`
  // no longer diffs it away as drift.
  @@index([email])
}

model Session {
  id        String   @id // opaque token (web mirror uses HttpOnly cookie)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  expiresAt DateTime
}

// FCM registration tokens for push delivery (Task B2). One row per
// (user, device-token): re-registering refreshes lastSeenAt; users keep at
// most MAX_TOKENS_PER_USER rows (oldest evicted). RLS: members see/modify
// only their own rows; usrah heads/invigilators may SELECT (resolve for
// fan-out) but never mutate — and only same-gender rows (see the
// *_device_tokens migration).
model DeviceToken {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token      String // FCM registration token (device+app install)
  platform   String   @default("android") // android | ios
  lastSeenAt DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now())

  @@unique([userId, token])
  @@index([userId])
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  familyId  String // rotation family — revoked as a whole on reuse detection
  tokenHash String    @unique // sha256 of the issued JWT refresh token
  expiresAt DateTime
  usedAt    DateTime? // set on first use; a second use = replay → family revoked
  revokedAt DateTime?
  createdAt DateTime  @default(now())
}

model OtpCode {
  id        String   @id @default(cuid())
  phone     String
  // sha256(phone:code) — the PLAINTEXT code never touches the database
  // (Phase C/W2b; was a plaintext `code` column).
  codeHash  String
  attempts  Int      @default(0)
  createdAt DateTime @default(now())
  expiresAt DateTime
}

model ReferralClosure {
  id           String   @id @default(cuid())
  ancestorId   String
  descendantId String
  depth        Int
  createdAt    DateTime @default(now())

  @@unique([ancestorId, descendantId])
}

model Usrah {
  id                String   @id @default(cuid())
  name              String
  gender            String // must equal head's and all members' gender
  headUserId        String?  @unique
  invigilatorUserId String?
  district          String?
  createdAt         DateTime @default(now())

  members       User[]         @relation("UsrahMembers")
  announcements Announcement[]
  questions     UsrahQuestion[]
}

// ─────────────────────────── Muhasaba diary ───────────────────────────

model AmalDefinition {
  id         String  @id @default(cuid())
  key        String  @unique
  titleBn    String
  titleEn    String
  category   String // salah | quran | dhikr | akhlaq | dawat | lifestyle | sunnah
  inputType  String // tristate | boolean | count | quantity | text
  cadence    String  @default("daily") // daily | weekly:fri | weekly:mon_thu | monthly:ayyam_beez
  targetJson Json? // {"general":1,"hafez":1,"alim":10} + unit
  unit       String? // পৃষ্ঠা / পারা / মিনিট / টি
  minLevel   String  @default("none")
  sortOrder  Int     @default(0)
  autoSource String? // e.g. auto:adhkar:morning, auto:quran:tilawat, auto:prayer:fajr
  active     Boolean @default(true)
}

model AmalEntry {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  amalKey         String
  date            String // YYYY-MM-DD (Gregorian, natural key part)
  hijriDate       String? // e.g. 1446-12-10
  valueJson       Json // tristate: "jamaat|alone|qaza"; boolean: true; count/quantity: number
  source          String   @default("manual") // manual | auto:<feature>
  clientUpdatedAt DateTime // conflict winner
  serverUpdatedAt DateTime @default(now())

  @@unique([userId, amalKey, date])
  @@index([userId, date])
}

model DayUnlock {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation("UnlockedFor", fields: [userId], references: [id], onDelete: Cascade)
  date      String // YYYY-MM-DD unlocked for this user
  byUserId  String
  byUser    User     @relation("UnlockedBy", fields: [byUserId], references: [id])
  reason    String?
  createdAt DateTime @default(now())

  @@unique([userId, date])
}

// Phase C/W4c: the goal lifecycle — set → mentor approve → remind → review.
// A member PROPOSES (status "proposed"); the usrah head/invigilator approves
// (which fires a Reminder for the member) or rejects with a reason. Terminal
// statuses (rejected|completed|withdrawn) stay for history — `active` is kept
// in sync (true only while proposed/approved) so the max-14 cap and the
// legacy client field keep their meaning.
model PersonalGoal {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  amalKey     String
  title       String
  note        String? // reviewer notes
  target      String? // free-form target description
  startDate   String
  active      Boolean   @default(true)
  status      String    @default("proposed") // proposed | approved | rejected | completed | withdrawn
  decidedById String? // the head/invigilator/admin who approved or rejected
  decidedAt   DateTime?
  reason      String? // head's note on rejection
  createdAt   DateTime  @default(now())
}

// ─────────────────────────── Monthly Muhasaba report ───────────────────────────

model MonthlyReport {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  month       String // YYYY-MM (Gregorian)
  storageKey  String // reports/{userId}/{month}.pdf (S3 object or STORAGE_DIR-relative path)
  byteSize    Int      @default(0)
  status      String   @default("ready") // ready | failed
  errorBn     String? // failure reason (Bengali, worker-set)
  generatedAt DateTime @default(now())

  @@unique([userId, month])
  @@index([month])
}

// ─────────────────────────── Reviews & assessment ───────────────────────────

model WeeklyReview {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation("Reviewee", fields: [userId], references: [id], onDelete: Cascade)
  reviewerId   String
  reviewer     User      @relation("Reviewer", fields: [reviewerId], references: [id])
  weekStart    String // YYYY-MM-DD (Saturday, BD week convention)
  summaryJson  Json? // auto: per-category completion, streaks, missed days
  comment      String?
  rating       Int?
  nextGoals    String?
  status       String    @default("pending") // pending | done | overdue
  createdAt    DateTime  @default(now())
  completedAt  DateTime?

  @@unique([userId, weekStart])
}

model AssessmentTemplate {
  id           String   @id @default(cuid())
  key          String // template family, e.g. farze_ain_v1.1 — versions share it
  version      Int      @default(1)
  titleBn      String
  titleEn      String
  sectionsJson Json // [{key,titleBn,criteria:[{key,titleBn,hintBn}]}]
  // Verbatim client form metadata (Phase C/D): instructions, the two
  // category descriptions, scale, header fields, signature labels,
  // summary spec — everything the paper form carries besides the criteria.
  metaJson     Json?
  // Versioned activation (B6): exactly one row per key should be active; the
  // member-facing GET /api/assessments/templates serves only active versions.
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())

  @@unique([key, version])
  @@index([key, active])
}

model Assessment {
  id                  String    @id @default(cuid())
  templateKey         String
  assesseeId          String
  assessee            User      @relation("Assessee", fields: [assesseeId], references: [id])
  assessorId          String
  assessor            User      @relation("Assessor", fields: [assessorId], references: [id])
  participantCategory Int       @default(1) // 1 = beginner (45–60 min/day), 2 = advanced (60–90)
  scoresJson          Json // {"criterionKey": {score: 0|1|2, comment?}}
  overallComment      String?
  assessorSignedAt    DateTime?
  assesseeSignedAt    DateTime? // set by the OTP-confirmed acknowledgment (W4i)
  result              String    @default("not_yet") // passed | not_yet
  // W4i — the farze-ain result only becomes FINAL (effective) after the
  // ASSESSEE's own OTP-confirmed acknowledgment: submitted scores start
  // pending_confirmation; confirm sets status confirmed + assesseeSignedAt,
  // decline sets declined (+ decisionNote). Only confirmed assessments
  // satisfy the level-transition "assessment_passed" rule.
  status              String    @default("pending_confirmation") // pending_confirmation | confirmed | declined
  confirmedAt         DateTime?
  declinedAt          DateTime?
  decisionNote        String? // the assessee's decline reason
  createdAt           DateTime  @default(now())
}

model LevelTransition {
  id           String   @id @default(cuid())
  userId       String
  fromLevel    String
  toLevel      String
  // B6: provenance + justification. method "auto" = nightly levels job,
  // "admin" = manual override via POST /api/admin/promote (reason required).
  method       String   @default("admin") // auto | admin
  reason       String?
  actorId      String? // promoting admin (null for auto)
  at           DateTime @default(now())
  evidenceJson Json? // {assessmentId, monthsInLevel, referralsAtLevel}

  @@index([userId])
}

// ─────────────────────────── Content & engagement ───────────────────────────

model Announcement {
  id        String   @id @default(cuid())
  usrahId   String?
  usrah     Usrah?   @relation(fields: [usrahId], references: [id])
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
  kind      String   @default("announcement") // announcement | question | exam
  body      String
  pinned    Boolean  @default(false)
  // audience of a Foundation-wide (usrahId null) announcement: null =
  // everyone (guests too), "M"/"F" = that gender only
  gender    String?
  createdAt DateTime @default(now())
}

model Reminder {
  id          String    @id @default(cuid())
  userId      String
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind        String // prayer | review | broadcast | live | goal | detox | assessment
  title       String
  body        String?
  link        String? // app subview hint
  scheduledAt DateTime?
  read        Boolean   @default(false)
  createdAt   DateTime  @default(now())
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String // unlock_day | change_role | change_gender | promote_level | broadcast | sign_assessment
  targetType String
  targetId   String?
  metaJson   Json?
  createdAt  DateTime @default(now())
}

// Phase C/W1b: ONE editable app configuration — /api/config reads it (with a
// short cache), the admin CMS (PATCH /api/admin/config) writes it, and
// seed:reference upserts the defaults from packages/content/app-config.json.
model AppConfigRow {
  key        String   @id // singleton: "app"
  valueJson  Json
  updatedAt  DateTime @updatedAt
}

model MasalaQuestion {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  name      String
  phone     String?
  question  String
  status    String   @default("new") // new | answered
  answer    String?
  answeredAt   DateTime?
  answeredById String?
  createdAt DateTime @default(now())
}

model Feedback {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  message   String
  // where it came from: "app 1.0.0 · Android 13" (sent by the app) — the
  // admin reads a tester's report with its device next to it
  context   String?
  status    String   @default("new") // new | done
  createdAt DateTime @default(now())
}

model LiveProgram {
  id           String    @id @default(cuid())
  titleBn      String
  descBn       String?
  hostName     String?
  startsAt     DateTime
  endsAt       DateTime?
  youtubeId    String? // unlisted embed; female sessions are never public
  gender       String    @default("M") // audience gender scope
  status       String    @default("upcoming") // upcoming | live | past
  recordingUrl String?
  quizId       String? // AMOL-17: a scheduled live quiz (packages/content quizzes.json id)
  createdAt    DateTime  @default(now())
}

model Enrollment {
  id           String   @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId     String
  progressJson Json     @default("{}") // {lessonIndex, completed: []}
  updatedAt    DateTime @default(now())

  @@unique([userId, courseId])
}

model QuizAttempt {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  quizId    String
  score     Int
  total     Int
  createdAt DateTime @default(now())
}

// Usrah question board (Task B4): a member asks a deen/tarbiyah question
// inside their OWN usrah; the usrah head (or supervisors) answers. Visibility
// is usrah-scoped at the DATABASE level — see the *_usrah_questions migration
// (SELECT = own usrah / same-gender invigilator / admin; INSERT = own usrah
// members; UPDATE = head of that usrah / admin — answering).
model UsrahQuestion {
  id            String    @id @default(cuid())
  usrahId       String
  usrah         Usrah     @relation(fields: [usrahId], references: [id])
  authorId      String
  author        User      @relation("UsrahQuestionAuthor", fields: [authorId], references: [id])
  category      String    @default("general") // general | aqeedah | salah | quran | muamalah | tarbiyah
  question      String
  answer        String?
  answeredById  String?
  answeredBy    User?     @relation("UsrahQuestionAnswerer", fields: [answeredById], references: [id])
  answeredAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @default(now())

  @@index([usrahId, createdAt])
}

// ─────────────────────────── Live support threads (W4d) ───────────────────────────
// User ↔ admin support conversation. A member opens a thread (status "open");
// every admin reply flips it to "answered"; a member reply on an answered
// thread flips it back to "open" (awaits the support team again); an admin can
// close it (terminal — appending to a closed thread is refused with 400).
// RLS (migrations/*_support_threads): members see/write ONLY their own rows
// (admins are full_admin — bypass), full_admin/system read + moderate all.
model SupportThread {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject     String
  status      String    @default("open") // open | answered | closed
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  closedAt    DateTime?
  closedById  String? // the admin who closed (name resolved via system reads)
  messages    SupportMessage[]

  @@index([userId, createdAt])
}

// One message inside a support thread. authorId is ALWAYS set — it is the
// member (isAdmin=false) or the full_admin actor (isAdmin=true); there are no
// anonymous/system messages today (nullable would only be needed for those).
model SupportMessage {
  id        String   @id @default(cuid())
  threadId  String
  thread    SupportThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation("SupportMessageAuthor", fields: [authorId], references: [id])
  body      String
  isAdmin   Boolean  @default(false) // true = written by the support team (full_admin)
  createdAt DateTime @default(now())

  @@index([threadId, createdAt])
}

// ─────────────────────────── Usrah join requests (W4d) ───────────────────────────
// A member WITHOUT an usrah asks to be assigned; full_admin approves into a
// concrete usrah (which sets User.usrahId — the assignment) or rejects with a
// reason. ONE pending request per user is enforced in the service (the POST is
// idempotent while a request is pending). Statuses pending|approved|rejected.
model UsrahJoinRequest {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  message     String? // the member's note to the tarbiyah office
  status      String    @default("pending")
  handledById String? // the admin who approved/rejected
  handledAt   DateTime?
  usrahId     String? // the usrah assigned on approve
  reason      String? // admin's note on rejection
  createdAt   DateTime  @default(now())

  @@index([userId, createdAt])
  @@index([status, createdAt])
}

// Content workflow (2026-10-09): every version of every content pack —
// draft → in_review → published (or rejected back to the editor); the
// newest published revision is what the apps serve (also written to the
// pack override file). Older published revisions stay for rollback.
// System-only RLS: the CMS endpoints check the content role first.
model ContentRevision {
  id          String    @id @default(cuid())
  pack        String
  version     Int
  status      String    // draft | in_review | published | rejected | archived
  dataJson    Json
  itemCount   Int       @default(0)
  note        String?   // the editor's change note
  reviewNote  String?   // the reviewer's note (required on reject)
  authorId    String
  reviewerId  String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  submittedAt DateTime?
  reviewedAt  DateTime?
  publishedAt DateTime?

  @@unique([pack, version])
  @@index([pack, status])
}
