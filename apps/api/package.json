{
  "name": "@sunnahlife/api",
  "version": "1.0.0",
  "description": "Sunnah Life — NestJS modular monolith (Prisma PostgreSQL + RLS, JWT auth, BullMQ queues)",
  "private": true,
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "start:worker": "node dist/worker.js",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "lint": "eslint .",
    "test": "jest",
    "openapi:export": "bun run src/scripts/export-openapi.ts",
    "smoke:quiz": "bun run src/scripts/quiz-smoke.ts",
    "prisma:generate": "prisma generate",
    "migrate": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "seed": "bun prisma/seed.ts",
    "db:reset": "prisma migrate reset --force"
  },
  "prisma": {
    "schema": "prisma/schema.prisma",
    "seed": "bun prisma/seed.ts"
  },
  "dependencies": {
    "@nestjs/bullmq": "^11.0.2",
    "@nestjs/common": "^11.1.6",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.6",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/platform-express": "^11.1.6",
    "@nestjs/platform-socket.io": "^11.1.6",
    "@nestjs/swagger": "^11.2.0",
    "@nestjs/throttler": "^6.4.0",
    "@nestjs/websockets": "^11.1.6",
    "@prisma/client": "^6.11.1",
    "bullmq": "^5.56.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "helmet": "^8.1.0",
    "ioredis": "^5.4.1",
    "minio": "^8.0.6",
    "pdfkit": "^0.17.1",
    "prisma": "^6.11.1",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "socket.io": "^4.8.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.10",
    "@nestjs/schematics": "^11.0.8",
    "@nestjs/testing": "^11.1.6",
    "@types/express": "^5.0.0",
    "@types/fontkit": "^2.0.9",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.0",
    "@types/pdfkit": "^0.17.1",
    "@types/supertest": "^6.0.3",
    "eslint": "^9.36.0",
    "jest": "^29.7.0",
    "socket.io-client": "^4.8.4",
    "supertest": "^7.1.4",
    "ts-jest": "^29.2.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.44.0"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "roots": ["<rootDir>/test"],
    "testMatch": ["**/*.spec.ts"],
    "moduleNameMapper": {
      "^src/(.*)$": "<rootDir>/src/$1"
    },
    "transform": {
      "^.+\\.ts$": ["ts-jest", {
        "isolatedModules": true,
        "tsconfig": {
          "experimentalDecorators": true,
          "emitDecoratorMetadata": true
        }
      }]
    },
    "testTimeout": 60000
  }
}
