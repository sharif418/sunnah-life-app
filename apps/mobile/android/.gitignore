# NOTE: the gradle wrapper (gradlew, gradlew.bat, gradle-wrapper.jar) IS
# committed on purpose — CI builds the APK on GitHub Actions and needs the
# wrapper; Flutter can regenerate it, but a committed wrapper is reproducible.
/.gradle
/captures/
/local.properties
GeneratedPluginRegistrant.java
.cxx/

