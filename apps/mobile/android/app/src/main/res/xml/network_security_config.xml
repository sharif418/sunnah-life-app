<?xml version="1.0" encoding="utf-8"?>
<!-- Qur'an recitation (2026-10-10): just_audio serves cached ayahs
     (LockCachingAudioSource) through its own small proxy on the phone,
     http://127.0.0.1:<port>. Android blocks plain http by default, so in a
     release build every play failed with "check the internet". Plain http is
     allowed ONLY to the phone itself; everything else stays https-only. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
