<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
        <!-- Task B2 — push notifications: APNs environment entitlement.
             Xcode resolves `development` from the automatic provisioning profile
             when the Push Notifications capability is toggled; App Store/TestFlight
             builds get the production environment at upload time. -->
        <key>aps-environment</key>
        <string>development</string>
        <!-- Task B5 — Sign in with Apple (sign_in_with_apple plugin). The
             entitlement must ALSO be present in the provisioning profile: on the
             signing Mac add the "Sign in with Apple" capability in Xcode once
             (docs/IOS_BUILD.md §9). Value is always ["Default"]. -->
        <key>com.apple.developer.applesignin</key>
        <array>
                <string>Default</string>
        </array>
        <!-- C-W3h — Universal Links: https://sunnahlife.app/join/* opens the
             app (the apple-app-site-association file served by apps/web
             whitelists the path — see docs/RELEASE.md §App Links for the
             TEAMID.appID that must match). The Associated Domains capability
             must ALSO be toggled on the App ID on the signing Mac
             (docs/IOS_BUILD.md) so the provisioning profile carries it;
             Xcode adds the profile side automatically when the capability
             is enabled there once. -->
        <key>com.apple.developer.associated-domains</key>
        <array>
                <string>applinks:sunnahlife.app</string>
        </array>
</dict>
</plist>
