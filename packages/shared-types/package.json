{
  "name": "@sunnahlife/shared-types",
  "version": "1.0.0",
  "private": true,
  "description": "Sunnah Life — typed client surface generated from the NestJS API's OpenAPI spec. Consumed by apps/web and apps/admin.",
  "type": "module",
  "main": "dist/schema.d.ts",
  "types": "dist/schema.d.ts",
  "exports": {
    ".": "./dist/schema.d.ts",
    "./openapi.json": "./dist/openapi.json"
  },
  "scripts": {
    "generate": "bun run scripts/generate.ts",
    "build": "npm run generate"
  },
  "devDependencies": {
    "openapi-typescript": "^7.4.4"
  }
}
